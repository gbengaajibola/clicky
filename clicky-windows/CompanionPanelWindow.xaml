<Window x:Class="Clicky.CompanionPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clicky"
        Width="340"
        Height="460"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize">

  <!-- Outer border gives the dark rounded-corner card appearance -->
  <Border Background="#FF121214"
          CornerRadius="16"
          BorderBrush="#28FFFFFF"
          BorderThickness="1">

    <Border.Effect>
      <DropShadowEffect Color="#FF000000"
                        BlurRadius="32"
                        ShadowDepth="8"
                        Opacity="0.6" />
    </Border.Effect>

    <DockPanel LastChildFill="True" Margin="0">

      <!-- ── Header ── -->
      <StackPanel DockPanel.Dock="Top" Margin="20,20,20,0">

        <DockPanel>
          <!-- Blue dot status indicator -->
          <Ellipse Width="8" Height="8"
                   Fill="#FF3B82F6"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"
                   Name="StatusDot" />

          <TextBlock Text="Clicky"
                     Foreground="#FFF2F2F7"
                     FontSize="17"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />

          <!-- Model picker pushed to the right -->
          <ComboBox DockPanel.Dock="Right"
                    HorizontalAlignment="Right"
                    Name="ModelPickerComboBox"
                    Background="#FF1C1C20"
                    Foreground="#FF8E8E93"
                    BorderBrush="#28FFFFFF"
                    FontSize="11"
                    Width="90"
                    SelectionChanged="OnModelPickerSelectionChanged">
            <ComboBoxItem Content="Sonnet" Tag="claude-sonnet-4-6" IsSelected="True" />
            <ComboBoxItem Content="Opus" Tag="claude-opus-4-6" />
          </ComboBox>
        </DockPanel>

        <!-- Thin separator -->
        <Border Height="1"
                Background="#28FFFFFF"
                Margin="0,16,0,0" />
      </StackPanel>

      <!-- ── Footer: Quit button ── -->
      <Button DockPanel.Dock="Bottom"
              Content="Quit Clicky"
              Margin="20,0,20,20"
              Height="36"
              Background="#FF1C1C20"
              Foreground="#FF8E8E93"
              BorderBrush="#28FFFFFF"
              BorderThickness="1"
              FontSize="13"
              Cursor="Hand"
              Click="OnQuitButtonClick">
        <Button.Style>
          <Style TargetType="Button">
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="Button">
                  <Border Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}"
                          CornerRadius="8">
                    <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#FF2C2C30" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                      <Setter Property="Background" Value="#FF3C3C40" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
          </Style>
        </Button.Style>
      </Button>

      <!-- ── Main content area ── -->
      <ScrollViewer DockPanel.Dock="Top"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="20,16,20,0">
        <StackPanel Spacing="12">

          <!-- Status card -->
          <Border Background="#FF1C1C20"
                  CornerRadius="10"
                  Padding="14,12">
            <StackPanel>
              <TextBlock Name="StatusLabel"
                         Text="Ready"
                         Foreground="#FFF2F2F7"
                         FontSize="14"
                         FontWeight="Medium" />
              <TextBlock Name="StatusDetailLabel"
                         Text="Press Ctrl + Alt to start talking"
                         Foreground="#FF8E8E93"
                         FontSize="11"
                         Margin="0,4,0,0"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <!-- Waveform visualizer (visible while recording) -->
          <Border Name="WaveformContainer"
                  Background="#FF1C1C20"
                  CornerRadius="10"
                  Padding="14,12"
                  Visibility="Collapsed">
            <Canvas Name="WaveformCanvas" Height="40" />
          </Border>

          <!-- Permissions section -->
          <Border Background="#FF1C1C20"
                  CornerRadius="10"
                  Padding="14,12">
            <StackPanel>
              <TextBlock Text="Permissions"
                         Foreground="#FF8E8E93"
                         FontSize="11"
                         FontWeight="Medium"
                         Margin="0,0,0,8" />

              <DockPanel Margin="0,0,0,6">
                <Ellipse Name="MicPermissionDot"
                         Width="6" Height="6"
                         Fill="#FF8E8E93"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock Text="Microphone"
                           Foreground="#FFF2F2F7"
                           FontSize="12"
                           VerticalAlignment="Center" />
              </DockPanel>

              <DockPanel>
                <Ellipse Name="ScreenPermissionDot"
                         Width="6" Height="6"
                         Fill="#FF8E8E93"
                         VerticalAlignment="Center"
                         Margin="0,0,8,0" />
                <TextBlock Text="Screen Capture"
                           Foreground="#FFF2F2F7"
                           FontSize="12"
                           VerticalAlignment="Center" />
              </DockPanel>
            </StackPanel>
          </Border>

          <!-- Show cursor overlay toggle -->
          <Border Background="#FF1C1C20"
                  CornerRadius="10"
                  Padding="14,12">
            <DockPanel>
              <TextBlock Text="Show Clicky cursor"
                         Foreground="#FFF2F2F7"
                         FontSize="13"
                         VerticalAlignment="Center" />
              <CheckBox Name="ShowCursorToggle"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        IsChecked="True"
                        Checked="OnShowCursorToggleChanged"
                        Unchecked="OnShowCursorToggleChanged" />
            </DockPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
